# Checkout the upstream revision specified by EXPECTED_AUDIO_OSCAR_COMMIT
# in stages/run_audio_oscar.py, then apply patches/audio_oscar.patch.
AUDIO_OSCAR_ROOT=/path/to/Audio-Oscar

# OpenAI-compatible planner and multimodal critic chosen by the reproducer.
AUDIO_OSCAR_PLANNER_URL=http://127.0.0.1:8000/v1
AUDIO_OSCAR_PLANNER_MODEL=YOUR_PLANNER_MODEL
AUDIO_OSCAR_OMNI_URL=http://127.0.0.1:8001
AUDIO_OSCAR_OMNI_MODEL=YOUR_AUDIO_CRITIC_MODEL

# Speech generation and forced alignment services.
AUDIO_OSCAR_QWEN_TTS_URL=http://127.0.0.1:8002/v1
AUDIO_OSCAR_COSYVOICE_URL=http://127.0.0.1:8003
AUDIO_OSCAR_VOXCPM_URL=http://127.0.0.1:8004/v1
AUDIO_OSCAR_FA_URL=http://127.0.0.1:8005/align
AUDIO_OSCAR_VOICE_DESIGN_MODEL=/path/to/voice-design-model
AUDIO_OSCAR_BASE_TTS_MODEL=/path/to/base-tts-model

# Sound-effect, music, song, and source-separation services.
AUDIO_OSCAR_STABLE_AUDIO_URL=http://127.0.0.1:8006/generate
AUDIO_OSCAR_ACESTEP_URL=http://127.0.0.1:8007
AUDIO_OSCAR_DEMUCS_HOST=127.0.0.1
AUDIO_OSCAR_DEMUCS_PORT=8008

# Audio-Oscar backend routing configs supplied by the reproducer.
AUDIO_OSCAR_TTA_CONFIG_PATH=/path/to/tta_config.json
AUDIO_OSCAR_MUSIC_CONFIG_PATH=/path/to/music_config.json
AUDIO_OSCAR_SONG_CONFIG_PATH=/path/to/song_config.json

# Frozen construction settings.
AUDIO_OSCAR_PLANNER_TEMPERATURE=0.1
AUDIO_OSCAR_PLANNER_ENABLE_THINKING=false
AUDIO_OSCAR_PLANNER_TIMEOUT=900
AUDIO_OSCAR_SPEECH_FA_MODE=llm_auto
AUDIO_OSCAR_SPEECH_GENERATION_WORKERS=1
AUDIO_OSCAR_TTA_GENERATION_WORKERS=4
AUDIO_OSCAR_AUDIO_CRITIC_WORKERS=4
AUDIO_OSCAR_RUN_FINAL_EDIT=true
# Reproduction runs keep this false. Set true only when intentionally testing
# an Audio-Oscar checkout other than aca87d722eaa00265023817cf42f29f6a3c1ad75.
AUDIO_OSCAR_ALLOW_UNPINNED=false
