# Repository and data roots (copy to configs/env.local and edit)
REPO_ROOT=/path/to/Spoken_Function_Calling
DATA_ROOT=${REPO_ROOT}/data
MS_SWIFT_ROOT=${REPO_ROOT}/ms-swift

# Base model for training / evaluation (required)
MODEL_PATH=/path/to/Qwen2.5-Omni-7B

# GPU settings
CUDA_VISIBLE_DEVICES=0,1,2,3
NPROC_PER_NODE=4

# Qwen2.5-Omni multimodal limits
VIDEO_MAX_PIXELS=50176
FPS_MAX_FRAMES=12
MAX_PIXELS=1003520
ENABLE_AUDIO_OUTPUT=0

# Training outputs
OUTPUT_ROOT=${REPO_ROOT}/outputs

# Evaluation
EVAL_OUTPUT_DIR=${REPO_ROOT}/project/eval/results
VLLM_PORT=12355
